<Project Sdk="Microsoft.NET.Sdk">
  <!-- .NET Framework 4.8 ships with Windows 10 (1903+) and 11: nothing else to install. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>7.3</LangVersion>
    <AssemblyName>DualPair</AssemblyName>
    <RootNamespace>DualPair</RootNamespace>
    <StartupObject>DualPair.Program</StartupObject>
    <ApplicationIcon>DualPair.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <Version>0.4.1</Version>
    <Product>DualPair</Product>
    <Description>DualPair for Windows: fixes what breaks when Windows and Linux share a PC</Description>
    <Copyright>DualPair contributors</Copyright>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <Deterministic>true</Deterministic>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Drawing" />
    <Reference Include="System.Web.Extensions" />
    <Reference Include="System.ServiceProcess" />
  </ItemGroup>
</Project>
